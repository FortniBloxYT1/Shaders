local Light = game.Lighting
local RunService = game:GetService("RunService")
local Path = workspace:FindFirstChild("Live") or workspace:FindFirstChild("Main") and workspace.Main:FindFirstChild("Live") or workspace
local Terrain = workspace.Terrain
local Environment = getgenv()

if Environment.BoogaShaderCleanup then
	Environment.BoogaShaderCleanup()
end

_G.Spring = false
_G.JPNDark = false
_G.JPN = false
_G.Glxy = true

local Objects = {}
local Connections = {}
local StoredLighting = {}
local ChangedStreetLights = {}
local ChangedWindowLights = {}
local ChangedParticles = {}
local OriginalTechnology
local OriginalDecoration
local OriginalLighting = {
	ShadowSoftness = Light.ShadowSoftness,
	Brightness = Light.Brightness,
	EnvironmentDiffuseScale = Light.EnvironmentDiffuseScale,
	EnvironmentSpecularScale = Light.EnvironmentSpecularScale,
	ExposureCompensation = Light.ExposureCompensation,
	GeographicLatitude = Light.GeographicLatitude,
	Ambient = Light.Ambient,
	ColorShift_Bottom = Light.ColorShift_Bottom,
	ColorShift_Top = Light.ColorShift_Top,
	FogEnd = Light.FogEnd,
	ClockTime = Light.ClockTime
}

pcall(function()
	OriginalTechnology = gethiddenproperty(Light, "Technology")
	OriginalDecoration = gethiddenproperty(Terrain, "Decoration")
end)

for _, Value in pairs(Light:GetChildren()) do
	if Value.Name ~= "Scouter"
		and Value.Name ~= "Water"
		and Value.Name ~= "SSJ"
		and Value.Name ~= "Sense"
		and Value.Name ~= "Stop"
		and Value.Name ~= "SSJ2"
		and Value.Name ~= "Flash"
		and Value.Name ~= "NovaBlur"
		and game.PlaceId ~= 18668065416
	then
		StoredLighting[#StoredLighting + 1] = Value
		Value.Parent = nil
	end
end

local function AddObject(Object)
	Objects[#Objects + 1] = Object
	Object.Parent = Light
	return Object
end

local function SetupStreetLamp(Object)
	if Object.Name ~= "StreetLamp" or not Object:FindFirstChild("Lamp") then return end

	local SpotLight = Object.Lamp:FindFirstChild("SpotLight")
	if not SpotLight or Object:FindFirstChild("ModelCutter") then return end

	if not ChangedStreetLights[SpotLight] then
		ChangedStreetLights[SpotLight] = {
			Brightness = SpotLight.Brightness,
			Color = SpotLight.Color
		}
	end

	SpotLight.Brightness = 2.5
	SpotLight.Color = Color3.fromRGB(252, 255, 130)
end

local function SetupWindowLight(Object)
	if not Object:IsA("PointLight") or not Object.Parent or not Object.Parent.Name:find("Window") then return end

	if not ChangedWindowLights[Object] then
		ChangedWindowLights[Object] = {
			Brightness = Object.Brightness,
			Color = Object.Color,
			Shadows = Object.Shadows
		}
	end

	Object.Brightness = 0.8
	Object.Color = Color3.fromRGB(255, 255, 180)
	Object.Shadows = true
end

local function SetupParticle(Object)
	if not Object:IsA("ParticleEmitter") or ChangedParticles[Object] then return end

	ChangedParticles[Object] = Object.Brightness
	Object.Brightness = 10

	Connections[#Connections + 1] = Object:GetPropertyChangedSignal("Brightness"):Connect(function()
		if _G.Glxy and Object.Parent and Object.Brightness ~= 10 then
			Object.Brightness = 10
		end
	end)
end

for _, Object in pairs(workspace:GetChildren()) do
	SetupStreetLamp(Object)
end

for _, Object in pairs(workspace:GetDescendants()) do
	SetupWindowLight(Object)
end

for _, Object in pairs(Path:GetDescendants()) do
	SetupParticle(Object)
end

Connections[#Connections + 1] = workspace.ChildAdded:Connect(SetupStreetLamp)
Connections[#Connections + 1] = workspace.DescendantAdded:Connect(SetupWindowLight)
Connections[#Connections + 1] = Path.DescendantAdded:Connect(SetupParticle)

local Bloom = AddObject(Instance.new("BloomEffect"))
local ColorCorrection = AddObject(Instance.new("ColorCorrectionEffect"))
local Depth = AddObject(Instance.new("DepthOfFieldEffect"))
local SunRay = AddObject(Instance.new("SunRaysEffect"))
local Sky0 = AddObject(Instance.new("Sky"))

Sky0.SkyboxBk = "rbxassetid://2118763079"
Sky0.SkyboxDn = "rbxassetid://2118766919"
Sky0.SkyboxFt = "rbxassetid://2118765204"
Sky0.SkyboxLf = "rbxassetid://2118764070"
Sky0.SkyboxRt = "rbxassetid://2118761853"
Sky0.SkyboxUp = "rbxassetid://2118766003"
Sky0.SunAngularSize = 15

local Cleanup
Cleanup = function()
	_G.Glxy = false

	for _, Connection in pairs(Connections) do
		Connection:Disconnect()
	end

	for Object, Values in pairs(ChangedStreetLights) do
		pcall(function()
			Object.Brightness = Values.Brightness
			Object.Color = Values.Color
		end)
	end

	for Object, Values in pairs(ChangedWindowLights) do
		pcall(function()
			Object.Brightness = Values.Brightness
			Object.Color = Values.Color
			Object.Shadows = Values.Shadows
		end)
	end

	for Object, Brightness in pairs(ChangedParticles) do
		pcall(function()
			Object.Brightness = Brightness
		end)
	end

	for _, Object in pairs(Objects) do
		Object:Destroy()
	end

	for _, Object in pairs(StoredLighting) do
		if not Object.Parent then
			Object.Parent = Light
		end
	end

	Light.ShadowSoftness = OriginalLighting.ShadowSoftness
	Light.Brightness = OriginalLighting.Brightness
	Light.EnvironmentDiffuseScale = OriginalLighting.EnvironmentDiffuseScale
	Light.EnvironmentSpecularScale = OriginalLighting.EnvironmentSpecularScale
	Light.ExposureCompensation = OriginalLighting.ExposureCompensation
	Light.GeographicLatitude = OriginalLighting.GeographicLatitude
	Light.Ambient = OriginalLighting.Ambient
	Light.ColorShift_Bottom = OriginalLighting.ColorShift_Bottom
	Light.ColorShift_Top = OriginalLighting.ColorShift_Top
	Light.FogEnd = OriginalLighting.FogEnd
	Light.ClockTime = OriginalLighting.ClockTime

	pcall(function()
		if OriginalTechnology ~= nil then
			sethiddenproperty(Light, "Technology", OriginalTechnology)
		end

		if OriginalDecoration ~= nil then
			sethiddenproperty(Terrain, "Decoration", OriginalDecoration)
		end
	end)

	if Environment.BoogaShaderCleanup == Cleanup then
		Environment.BoogaShaderCleanup = nil
	end
end

Environment.BoogaShaderCleanup = Cleanup

Connections[#Connections + 1] = RunService.PostSimulation:Connect(function()
	if _G.Glxy then
		Light.FogEnd = 20000
		Light.ClockTime = 14.5
	end
end)

while _G.Glxy and Environment.BoogaShaderCleanup == Cleanup do
	sethiddenproperty(Terrain, "Decoration", true)
	sethiddenproperty(Light, "Technology", "ShadowMap")
	sethiddenproperty(Light, "ShadowSoftness", 0.25)
	sethiddenproperty(Light, "Brightness", 3)
	sethiddenproperty(Light, "EnvironmentDiffuseScale", 0.2)
	sethiddenproperty(Light, "EnvironmentSpecularScale", 1)
	sethiddenproperty(Light, "ExposureCompensation", -2)
	sethiddenproperty(Light, "GeographicLatitude", -20.356)

	Light.Ambient = Color3.fromRGB(60, 30, 91)
	Light.Brightness = 3
	Light.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
	Light.ColorShift_Top = Color3.fromRGB(255, 255, 255)

	Bloom.Enabled = true
	Bloom.Intensity = 0.1
	Bloom.Size = 100
	Bloom.Threshold = 0

	ColorCorrection.Brightness = 0
	ColorCorrection.Contrast = 0
	ColorCorrection.Enabled = true
	ColorCorrection.Saturation = 0
	ColorCorrection.TintColor = Color3.fromRGB(255, 225, 255)

	Depth.Enabled = true
	Depth.FarIntensity = 0.9
	Depth.FocusDistance = 0.9
	Depth.InFocusRadius = 200
	Depth.NearIntensity = 0.5

	SunRay.Enabled = true
	SunRay.Intensity = 0.05
	SunRay.Spread = 1

	task.wait(2)
end
