local Light = game.Lighting
local RunService = game:GetService("RunService")
local Path = workspace:FindFirstChild("Live") or workspace:FindFirstChild("Main") and workspace.Main:FindFirstChild("Live") or workspace
local Terrain = workspace.Terrain
local Environment = getgenv()

if Environment.BoogaShaderCleanup then
	Environment.BoogaShaderCleanup()
end

_G.Spring = false
_G.JPNDark = false
_G.Glxy = false
_G.JPN = true

local Objects = {}
local Connections = {}
local StoredLighting = {}
local ChangedGrass = {}
local ChangedParticles = {}
local OriginalTechnology
local OriginalDecoration
local OriginalLighting = {
	ShadowSoftness = Light.ShadowSoftness,
	Brightness = Light.Brightness,
	EnvironmentDiffuseScale = Light.EnvironmentDiffuseScale,
	EnvironmentSpecularScale = Light.EnvironmentSpecularScale,
	ExposureCompensation = Light.ExposureCompensation,
	GeographicLatitude = Light.GeographicLatitude,
	Ambient = Light.Ambient,
	ColorShift_Bottom = Light.ColorShift_Bottom,
	ColorShift_Top = Light.ColorShift_Top,
	FogEnd = Light.FogEnd,
	ClockTime = Light.ClockTime
}

pcall(function()
	OriginalTechnology = gethiddenproperty(Light, "Technology")
	OriginalDecoration = gethiddenproperty(Terrain, "Decoration")
end)

for _, Value in pairs(Light:GetChildren()) do
	if Value.Name ~= "Scouter"
		and Value.Name ~= "Water"
		and Value.Name ~= "SSJ"
		and Value.Name ~= "Sense"
		and Value.Name ~= "Stop"
		and Value.Name ~= "SSJ2"
		and Value.Name ~= "Flash"
		and Value.Name ~= "NovaBlur"
		and game.PlaceId ~= 18668065416
	then
		StoredLighting[#StoredLighting + 1] = Value
		Value.Parent = nil
	end
end

local function AddObject(Object)
	Objects[#Objects + 1] = Object
	Object.Parent = Light
	return Object
end

local function SetupGrass(Object)
	if not Object:IsA("BasePart") or Object.Material ~= Enum.Material.Grass then return end

	if not ChangedGrass[Object] then
		ChangedGrass[Object] = Object.Color
	end

	Object.Color = Color3.fromRGB(15, 185, 105)
end

local function SetupParticle(Object)
	if not Object:IsA("ParticleEmitter") or ChangedParticles[Object] then return end

	ChangedParticles[Object] = Object.Brightness
	Object.Brightness = 5

	Connections[#Connections + 1] = Object:GetPropertyChangedSignal("Brightness"):Connect(function()
		if _G.JPN and Object.Parent and Object.Brightness ~= 5 then
			Object.Brightness = 5
		end
	end)
end

for _, Object in pairs(workspace:GetChildren()) do
	SetupGrass(Object)
end

for _, Object in pairs(Path:GetDescendants()) do
	SetupParticle(Object)
end

Connections[#Connections + 1] = workspace.ChildAdded:Connect(SetupGrass)
Connections[#Connections + 1] = Path.DescendantAdded:Connect(SetupParticle)
